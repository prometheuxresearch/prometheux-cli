{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheuxresearch.github.io/prometheux-cli/ontology.schema.json",
  "title": "Prometheux ontology manifest",
  "description": "prometheux.yaml — one ontology's lineage: concepts, datasources, ontology schema graph, apps, and ontology-scoped context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ontology"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Server ontology id. Absent on a brand-new ontology; filled by the first apply/pull."
        },
        "name": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "string",
          "enum": ["user", "organization"],
          "description": "Resolved against YOUR identity only (never targets another user)."
        }
      }
    },
    "datasources": {
      "type": "array",
      "description": "Relative paths to datasource spec files.",
      "items": { "type": "string", "minLength": 1 }
    },
    "concepts": {
      "type": "string",
      "description": "Directory holding concept bodies + .meta.yaml files.",
      "default": "./concepts"
    },
    "ontologySchema": {
      "type": "string",
      "description": "Path to the ontology schema graph file."
    },
    "apps": {
      "type": "string",
      "description": "Directory holding *.app.yaml AppDefinitions."
    },
    "context": {
      "type": "string",
      "description": "This ontology's context vault."
    }
  }
}
